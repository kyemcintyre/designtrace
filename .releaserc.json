{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/exec", {
      "prepareCmd": "mkdir -p dist && cat > dist/release-notes.md <<'DESIGNTRACE_NOTES_END'\n${nextRelease.notes}\nDESIGNTRACE_NOTES_END\nphp .github/scripts/package.php ${nextRelease.version} dist dist/release-notes.md"
    }],
    ["@semantic-release/github", {
      "assets": [{ "path": "dist/module_designtrace-*.zip", "label": "Dolibarr module package (module_designtrace-${nextRelease.version}.zip)" }],
      "successComment": false,
      "failComment": false,
      "releasedLabels": false
    }]
  ]
}
