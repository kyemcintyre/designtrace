# --- CAD and design files (never commit real designs) ---
*.FCStd
*.FCStd1
*.FCBak
*.f3d
*.step
*.stp
*.stl
*.3mf
*.obj
*.gcode
*.nc
# Allow small test fixtures only
!tests/fixtures/**

# --- Dolibarr runtime data ---
documents/
install.lock
conf.php

# --- Database dumps and backups (real customer data: never commit) ---
*.sql
*.sql.gz
*.sql.zst
*.dump
*.tgz
*.tar
*.tar.gz
*.bak
dumps/
# ...but the module's own schema files are source code
!designtrace/sql/*.sql

# --- Module Builder backups ---
*.back

# --- Secrets and local config ---
.env
.env.*
!.env.example

# --- Dependencies and build output ---
vendor/
node_modules/
/build/
dist/
*.zip

# --- Editor and OS files ---
.vscode/*
!.vscode/launch.json
.idea/
.DS_Store
Thumbs.db
*.swp
